{
  "brd": "BRD-25",
  "card": "OXE-167, OXE-172",
  "title": "OxeChat conversation anatomy (AG-10, AG-11)",
  "platform": "desktop",
  "source": "MARCA's CENAS-E-ALVOS-20261115 part B and AG-11-CRITERIOS-F5 (mockups AG-10-oxechat-conversa-vscode-agent.html and AG-11-anatomia-interna-conversa-oxechat.html), via the coordinator on 15/11; MARCA answers 4 (--measure-chat) and 7 (the split as one icon-button)",
  "measures": [
    { "id": "BRD-25.column.width", "scene": "chat-conversation", "select": "[data-ui=chat-column]", "prop": "width", "expect": { "token": "--measure-chat" }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.prompt.align", "scene": "chat-conversation", "select": "[data-ui=prompt-card]", "prop": "inline-start-offset", "of": "[data-ui=chat-column]", "expect": { "px": 0 }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.prompt.radius", "scene": "chat-conversation", "select": "[data-ui=prompt-card]", "prop": "border-radius", "expect": { "token": "--radius-lg" }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.turn-gap", "scene": "chat-anatomy", "select": "[data-ui=turn] + [data-ui=turn]", "prop": "margin-block-start", "expect": { "token": "--space-6" }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.fold.height", "scene": "chat-anatomy", "select": "[data-ui=turn-line]", "prop": "height", "expect": { "token": "--row-1" }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.step.height", "scene": "chat-anatomy", "select": "[data-ui=explore-group] [data-ui=step]", "prop": "height", "expect": { "px": 24 }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.reasoning.font", "scene": "chat-anatomy", "select": "[data-ui=reasoning]", "prop": "font-family", "expect": { "token": "--font-ui" }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.run-failed.open", "scene": "chat-anatomy", "select": "[data-ui=step][data-kind=run][data-state=failed] [aria-expanded]", "prop": "attr", "attr": "aria-expanded", "expect": { "eq": "true" }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.run-ok.closed", "scene": "chat-anatomy", "select": "[data-ui=step][data-kind=run][data-state=done] [aria-expanded]", "prop": "attr", "attr": "aria-expanded", "expect": { "eq": "false" }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.stderr.bg", "scene": "chat-anatomy", "select": "[data-ui=step][data-state=failed] [data-ui=step-output]", "prop": "background-color", "expect": { "token": "--term-bg" }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.table.vrule", "scene": "chat-anatomy", "select": "[data-ui=md-table] td + td", "prop": "border-left-width", "expect": { "px": 0 }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.alert.count", "scene": "chat-anatomy", "select": "[data-ui=alert]", "prop": "count", "expect": { "eq": 4 }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.request.rule", "scene": "chat-approval", "select": "[data-ui=request-card]", "prop": "border-left-color", "expect": { "token": "--attn" }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.request.buttons", "scene": "chat-approval", "select": "[data-ui=request-card] [data-ui=button]", "prop": "count", "expect": { "eq": 2 }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.request.split", "scene": "chat-approval", "select": "[data-ui=request-card] [data-ui=icon-button][aria-haspopup=menu]", "prop": "count", "expect": { "eq": 1 }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.working-set.height", "scene": "chat-anatomy", "select": "[data-ui=working-set]", "prop": "height", "expect": { "token": "--bar-sm" }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.composer.mode-first", "scene": "chat-conversation", "select": "[data-ui=composer-toolbar] > :first-child", "prop": "attr", "attr": "data-ui", "expect": { "eq": "mode-switch" }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.composer.controls", "scene": "chat-conversation", "select": "[data-ui=composer-toolbar] [data-ui=button], [data-ui=composer-toolbar] [data-ui=icon-button]", "prop": "count", "expect": { "max": 6 }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.header.meta", "scene": "chat-conversation", "select": "[data-ui=chat-header] [data-ui=chat-meta]", "prop": "count", "expect": { "eq": 0 }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" },
    { "id": "BRD-25.echo.needs-you", "scene": "chat-approval", "select": { "text": "Needs you", "within": "[data-ui=chat-column]" }, "prop": "count", "expect": { "eq": 0 }, "tolerance": 0.5, "densities": ["compact", "comfortable"], "themes": ["light", "dark"], "state": "enforced" }
  ]
}
